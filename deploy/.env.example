# Copy to .env in the project root on the server and fill in.
#   cp deploy/.env.example .env

# The domain Caddy requests a certificate for. Its DNS A record must already
# point at this machine, or the certificate request will fail.
DOMAIN=ledgerflow.example.com

# Let's Encrypt sends certificate warnings here. Required - Caddy will not
# start with an empty value.
EMAIL=you@example.com

# Postgres password. Nothing outside the compose network can reach the
# database, but a default credential is still a default credential.
# Generate one with:  openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# The break-the-books and poison-message controls. Left on because they are
# the most convincing part of a live demo; set to false to close them.
DEMO_ENDPOINTS=true
